<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tenant Configuration"
        SizeToContent="Height" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI" Background="#F0F4F8"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="REQ" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="#E03333"/>
            <Setter Property="Margin"     Value="6,0,0,4"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="BorderBrush"              Value="#DDE2EA"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="BorderBrush"              Value="#DDE2EA"/>
            <Setter Property="Padding"                  Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- PasswordBox mirrors the TextBox style so the masked secret field
             lines up visually with TenantId / ClientId next to it. WPF treats
             TextBox and PasswordBox as unrelated types — the implicit TextBox
             style does NOT carry over to PasswordBox. -->
        <Style TargetType="PasswordBox">
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="FontSize"                 Value="12"/>
            <Setter Property="BorderBrush"              Value="#DDE2EA"/>
            <Setter Property="Padding"                  Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding"      Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background"      Value="#1A6EF5"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1662D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#E5E7EB"/>
                                <Setter Property="Foreground" Value="#9AA3B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecBtn" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="#444"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="BorderBrush"     Value="#DDE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#1662D9"/>
                                <Setter Property="Foreground"  Value="#1662D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"  Value="#AAA"/>
                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Trash icon button — same shape as SecBtn (white background,
             grey border, blue border on hover) but square 30x30 for a
             single icon. Foreground is black so the trash icon visually
             matches the other icon-only buttons (Download / Config /
             Options) and flips to blue on hover for consistency with the
             other secondary icon buttons. -->
        <Style x:Key="TrashBtn" TargetType="Button">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Foreground"      Value="Black"/>
            <Setter Property="BorderBrush"     Value="#DDE2EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width"           Value="30"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#1662D9"/>
                                <Setter Property="Foreground"  Value="#1662D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity"     Value="0.3"/>
                                <Setter Property="Cursor"      Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Card -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0" Height="277">
                    <StackPanel>

                        <!-- TENANTS: dropdown + trash icon -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource FL}" Text="Select or create a tenant"/>
                                <ComboBox x:Name="lstTenants" Padding="11,0,0,0"/>
                            </StackPanel>
                            <!-- Trash icon — grayed out for Basetune Default, black for real tenants -->
                            <Button x:Name="btnRemoveTenant" Grid.Column="2"
                                    Style="{StaticResource TrashBtn}"
                                    IsEnabled="False" VerticalAlignment="Bottom"
                                    ToolTip="Remove tenant">
                                <Viewbox Width="16" Height="16" Stretch="Uniform">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>

                        <!-- Empty-state hint: shown when no tenant is selected -->
                        <StackPanel x:Name="pnlDefaultPaths" Visibility="Visible">
                            <!-- Display Name | Authentication Method -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FL}" Text="Display Name"/>
                                    <TextBox IsEnabled="False" Foreground="#999"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FL}" Text="Authentication Method"/>
                                    <TextBox IsEnabled="False" Foreground="#999"/>
                                </StackPanel>
                            </Grid>
                            <!-- Fixed two-row grid matching tenant form exactly -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,14" VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FL}" Text="Tenant ID"/>
                                        <TextBox IsEnabled="False" Foreground="#999"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="1" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FL}" Text="Client ID"/>
                                        <TextBox IsEnabled="False" Foreground="#999"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FL}" Text="Client Secret"/>
                                        <TextBox IsEnabled="False" Foreground="#999"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <!-- Tenant form -->
                        <StackPanel x:Name="pnlTenantForm" Visibility="Collapsed">

                            <!-- Display Name | Authentication Method -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource FL}" Text="Display Name"/>
                                        <TextBlock x:Name="reqDisplayName" Style="{StaticResource REQ}" Text="Required"/>
                                    </StackPanel>
                                    <TextBox x:Name="cfgTenantDisplayName"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FL}" Text="Authentication Method"/>
                                    <ComboBox x:Name="cfgTenantAuthMethod" Padding="10,0,0,0">
                                        <ComboBoxItem Content="ClientSecret" IsSelected="True"/>
                                        <ComboBoxItem Content="Certificate"/>
                                        <ComboBoxItem Content="None (JSON)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Credential area: fixed two-row grid so JSON and Secret/Cert views
                                 occupy identical height and the window never resizes -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>  <!-- Tenant ID row -->
                                    <RowDefinition Height="Auto"/>  <!-- Client ID / Secret row -->
                                </Grid.RowDefinitions>

                                <!-- ROW 0: Tenant ID (hidden for None) -->
                                <Grid x:Name="pnlTenantId" Grid.Row="0" Margin="0,0,0,14" VerticalAlignment="Top">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource FL}" Text="Tenant ID"/>
                                            <TextBlock x:Name="reqTenantId" Style="{StaticResource REQ}" Text="Required"/>
                                        </StackPanel>
                                        <TextBox x:Name="cfgTenantTenantId"/>
                                    </StackPanel>
                                </Grid>

                                <!-- ROW 1: Client ID | Client Secret (hidden for None) -->
                                <Grid x:Name="pnlCredential" Grid.Row="1" Margin="0,0,0,0" VerticalAlignment="Top">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" x:Name="pnlClientId">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource FL}" Text="Client ID"/>
                                            <TextBlock x:Name="reqClientId" Style="{StaticResource REQ}" Text="Required"/>
                                        </StackPanel>
                                        <TextBox x:Name="cfgTenantClientId"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="lblTenantSecret" Style="{StaticResource FL}" Text="Client Secret"/>
                                            <TextBlock x:Name="reqClientSecret" Style="{StaticResource REQ}" Text="Required"/>
                                        </StackPanel>
                                        <Grid>
                                            <!-- Default: PasswordBox (masked). Reveal-toggle flips visibility
                                                 with the TextBox below; the reveal button updates the value
                                                 on both controls so flipping is lossless. -->
                                            <PasswordBox x:Name="cfgTenantClientSecret" Padding="8,4,32,4"/>
                                            <TextBox     x:Name="cfgTenantClientSecretShown" Padding="8,4,32,4" Visibility="Collapsed"/>
                                            <Button x:Name="btnRevealSecret"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Width="28" Height="24" Margin="0,0,3,0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="0"
                                                    Foreground="#DDE2EA"
                                                    ToolTip="Show / hide secret">
                                                <!-- Two inline SVG paths in a Canvas, sized 12x12 to match the
                                                     previous Segoe MDL2 glyph height. The PS code-behind toggles
                                                     Visibility between iconEyeOpen and iconEyeOff instead of
                                                     swapping a font-glyph string. Font-independent = identical
                                                     rendering on every Windows install, no Segoe MDL2 fallback. -->
                                                <Grid Width="12" Height="12">
                                                    <Path x:Name="iconEyeOpen"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.0"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M2 12 C 5 6, 9 5, 12 5 C 15 5, 19 6, 22 12 C 19 18, 15 19, 12 19 C 9 19, 5 18, 2 12 Z M 12 9 A 3 3 0 1 1 12 15 A 3 3 0 1 1 12 9 Z"/>
                                                    <Path x:Name="iconEyeOff"
                                                          Stretch="Uniform"
                                                          Visibility="Collapsed"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.0"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          StrokeLineJoin="Round"
                                                          Data="M3 3 L 21 21 M 6.5 6.5 C 4.5 8, 3 10, 2 12 C 5 18, 9 19, 12 19 C 13.5 19, 15 18.7, 16.3 18.3 M 9.5 9.5 A 3 3 0 0 0 14.5 14.5 M 17.5 17.5 C 19.5 16, 21 14, 22 12 C 19 6, 15 5, 12 5 C 10.5 5, 9 5.3, 7.7 5.7"/>
                                                </Grid>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent" CornerRadius="3">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Foreground" Value="#1662D9"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="lblTenantThumb" Style="{StaticResource FL}"
                                                       Text="Certificate Thumbprint" Visibility="Collapsed"/>
                                            <TextBlock x:Name="reqCertThumb" Style="{StaticResource REQ}" Text="Required"/>
                                        </StackPanel>
                                        <TextBox x:Name="cfgTenantCertThumbprint" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>

                                <!-- JSON Path — spans both rows, only visible for None (JSON) -->
                                <Grid x:Name="pnlTenantPath" Grid.Row="0" Grid.RowSpan="2"
                                      Visibility="Collapsed" VerticalAlignment="Top" Margin="0,0,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource FL}" Text="JSON Path"/>
                                            <TextBlock x:Name="reqJsonPath" Style="{StaticResource REQ}" Text="Required"/>
                                        </StackPanel>
                                        <Grid>
                                            <TextBox x:Name="cfgTenantPath" Padding="8,4,32,4"/>
                                            <Button x:Name="btnBrowseTenantPath"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Width="28" Height="24" Margin="0,0,3,0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" Padding="0"
                                                    FontSize="12" Foreground="#888" Content="...">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="Transparent" CornerRadius="3">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Foreground" Value="#1662D9"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Bottom bar -->
                <Grid Grid.Row="2" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Connection test feedback. Set by btnSaveConfig's Click
                         handler before/after the New-GraphConnection probe.
                         Default empty so the bar looks clean when idle. -->
                    <TextBlock x:Name="lblConnectionStatus" Grid.Column="0"
                               VerticalAlignment="Center" Margin="4,0,8,0"
                               FontSize="12" Text=""/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnAddTenant" Style="{StaticResource PrimaryBtn}"
                                Content="New Tenant" MinWidth="110" Padding="14,0" Margin="0,0,8,0"/>
                        <Button x:Name="btnSaveConfig" Style="{StaticResource PrimaryBtn}"
                                Content="Save Config" MinWidth="110" Padding="14,0" Margin="0,0,8,0"
                                IsEnabled="False"/>
                        <Button x:Name="btnCloseConfig" Style="{StaticResource SecBtn}"
                                Content="Close" MinWidth="90" Padding="14,0"/>
                    </StackPanel>
                </Grid>

    </Grid>
</Window>